SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
DATABASE_URL=your-postgres-connection-string

# --- WhatsApp automatic payment receipts -------------------------------------
# Server-side only. Never put these in a VITE_* variable - anything prefixed
# that way is bundled into the browser and would leak the token to every
# visitor. Set them as plain environment variables in the Vercel project.
#
# Both values are required before any receipt is sent. Until then payments are
# still recorded normally and the receipt is simply marked "skipped".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional overrides. The defaults are shown.
# Name printed on the receipt.
GYM_NAME=Maruthi Gym
# Must match the approved template name in the Meta dashboard.
WHATSAPP_TEMPLATE_NAME=gym_payment_receipt
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v21.0
# How long to wait on Meta before giving up, in ms.
WHATSAPP_TIMEOUT_MS=8000
# Set to "true" to print the receipt to the server log and change nothing else.
# Nothing is sent to Meta, and the payment is recorded as "skipped" - never
# "sent" - so the database cannot claim a delivery that did not happen. Turn it
# off and press Resend on a payment to deliver for real.
WHATSAPP_DRY_RUN=false

# --- The blue receipt card ----------------------------------------------------
# "image" (default) sends the card as the template's image header, which is the
# only way a business-initiated WhatsApp message can carry a picture. "text"
# sends the text body alone, for a text-only approved template.
WHATSAPP_RECEIPT_STYLE=image
# REQUIRED for the image style. WhatsApp downloads the card from this address, so
# it must be a public https URL that Meta can reach - localhost will not work,
# and the value is ignored entirely in local development. Vercel sets VERCEL_URL
# automatically, so this is only needed to override it (e.g. a custom domain, or
# a preview deployment that should point elsewhere). Include the scheme:
# WHATSAPP_PUBLIC_BASE_URL=https://maruthigym.com
WHATSAPP_PUBLIC_BASE_URL=
